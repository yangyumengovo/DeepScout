# ===== LLM（OpenAI 兼容接口，任选一家）=====
# DeepSeek 示例（默认）：
DEEPSCOUT_LLM_API_KEY=sk-xxxx
DEEPSCOUT_LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSCOUT_LLM_MODEL=deepseek-chat
# 智谱 GLM 示例：
# DEEPSCOUT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEEPSCOUT_LLM_MODEL=glm-4-flash
# 阿里通义示例：
# DEEPSCOUT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSCOUT_LLM_MODEL=qwen-plus

# ===== 搜索供应商：ddgs（默认，免 key）| tavily | mock =====
DEEPSCOUT_SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=

# ===== 向量检索：none（默认，仅 BM25）| fastembed（bge-small-zh，本地免费）=====
DEEPSCOUT_EMBED_PROVIDER=none

# ===== 重排（RAG 召回->重排->引用 的第二层）：none | fastembed =====
# 需先安装可选依赖：pip install ".[rerank]"（首次运行自动下载模型，国内可设 HF_ENDPOINT=https://hf-mirror.com）
DEEPSCOUT_RERANK_PROVIDER=none
DEEPSCOUT_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 行为参数 =====
DEEPSCOUT_MAX_SUBQUERIES=3
DEEPSCOUT_MAX_FETCH_PER_QUERY=3
